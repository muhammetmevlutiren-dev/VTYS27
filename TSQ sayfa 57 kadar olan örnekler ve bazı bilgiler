CREATE TABLE SayiHavuzu (
    Sayi INT
);

DECLARE @Sayac INT = 1;

WHILE @Sayac <= 10
BEGIN
    IF @Sayac % 2 = 1 
    BEGIN
        SET @Sayac = @Sayac + 1;
        CONTINUE;
    END

    IF @Sayac = 8 
    BEGIN
        PRINT '8 değerine ulaşıldı, döngü sonlandırıldı.';
        BREAK;
    END

    INSERT INTO SayiHavuzu (Sayi) VALUES (@Sayac);
    SET @Sayac = @Sayac + 1;
END

SELECT * FROM SayiHavuzu;



