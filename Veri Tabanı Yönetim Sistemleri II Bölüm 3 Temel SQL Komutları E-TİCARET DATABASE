/*SORU1*/
SELECT 
    CITIES.CITY, 
    SUM(ORDERS.TOTALPRICE) AS TOTALSALE
FROM ORDERS
JOIN ADDRESS ON ORDERS.ADDRESSID = ADDRESS.ID
JOIN CITIES ON ADDRESS.CITYID = CITIES.ID
GROUP BY CITIES.CITY;



/*SORU2*/
SELECT 
    CITIES.CITY,
    DATENAME(MONTH, ORDERS.DATE_) AS AY,
    SUM(ORDERS.TOTALPRICE) AS TOTALSALE
FROM ORDERS
JOIN ADDRESS ON ORDERS.ADDRESSID = ADDRESS.ID
JOIN CITIES ON ADDRESS.CITYID = CITIES.ID
GROUP BY CITIES.CITY, DATENAME(MONTH, ORDERS.DATE_);

/*SORU3*/
SELECT 
    CITIES.CITY,
    DATENAME(WEEKDAY, ORDERS.DATE_) AS DAYOFWEEK_,
    SUM(ORDERS.TOTALPRICE) AS TOTALSALE
FROM ORDERS
JOIN ADDRESS ON ORDERS.ADDRESSID = ADDRESS.ID
JOIN CITIES ON ADDRESS.CITYID = CITIES.ID
GROUP BY CITIES.CITY, DATENAME(WEEKDAY, ORDERS.DATE_);

/*SORU4*/
SELECT 
    CITIES.CITY,
    SUM(CASE WHEN DATENAME(WEEKDAY, ORDERS.DATE_) = 'Pazartesi' THEN ORDERS.TOTALPRICE ELSE 0 END) AS PAZARTESİ,
    SUM(CASE WHEN DATENAME(WEEKDAY, ORDERS.DATE_) = 'Salı' THEN ORDERS.TOTALPRICE ELSE 0 END) AS SALI,
    SUM(CASE WHEN DATENAME(WEEKDAY, ORDERS.DATE_) = 'Çarşamba' THEN ORDERS.TOTALPRICE ELSE 0 END) AS ÇARŞAMBA,
    SUM(CASE WHEN DATENAME(WEEKDAY, ORDERS.DATE_) = 'Perşembe' THEN ORDERS.TOTALPRICE ELSE 0 END) AS PERŞEMBE,
    SUM(CASE WHEN DATENAME(WEEKDAY, ORDERS.DATE_) = 'Cuma' THEN ORDERS.TOTALPRICE ELSE 0 END) AS CUMA,
    SUM(CASE WHEN DATENAME(WEEKDAY, ORDERS.DATE_) = 'Cumartesi' THEN ORDERS.TOTALPRICE ELSE 0 END) AS CUMARTESİ,
    SUM(CASE WHEN DATENAME(WEEKDAY, ORDERS.DATE_) = 'Pazar' THEN ORDERS.TOTALPRICE ELSE 0 END) AS PAZAR
FROM ORDERS
JOIN ADDRESS ON ORDERS.ADDRESSID = ADDRESS.ID
JOIN CITIES ON ADDRESS.CITYID = CITIES.ID
GROUP BY CITIES.CITY;

/*SORU5*/
WITH SIRALAMA AS (
    SELECT 
        CITIES.CITY,
        ITEMS.CATEGORY1,
        SUM(ORDERDETAILS.LINETOTAL) AS TOTALSALE,
        ROW_NUMBER() OVER(PARTITION BY CITIES.CITY ORDER BY SUM(ORDERDETAILS.LINETOTAL) DESC) AS SIRA
    FROM ORDERDETAILS
    JOIN ITEMS ON ORDERDETAILS.ITEMID = ITEMS.ID
    JOIN ORDERS ON ORDERDETAILS.ORDERID = ORDERS.ID
    JOIN ADDRESS ON ORDERS.ADDRESSID = ADDRESS.ID
    JOIN CITIES ON ADDRESS.CITYID = CITIES.ID
    GROUP BY CITIES.CITY, ITEMS.CATEGORY1
)
SELECT CITY, CATEGORY1, TOTALSALE
FROM SIRALAMA
WHERE SIRA <= 5;


/*SORU6*/
WITH SIRALAMA AS (
    SELECT 
        CITIES.CITY,
        ITEMS.CATEGORY1,
        ITEMS.CATEGORY2,
        SUM(ORDERDETAILS.LINETOTAL) AS TOTALSALE,
        DENSE_RANK() OVER(PARTITION BY CITIES.CITY ORDER BY SUM(ORDERDETAILS.LINETOTAL) DESC) AS KAT_SIRA,
        ROW_NUMBER() OVER(PARTITION BY CITIES.CITY, ITEMS.CATEGORY1 ORDER BY SUM(ORDERDETAILS.LINETOTAL) DESC) AS ALT_KAT_SIRA
    FROM ORDERDETAILS
    JOIN ITEMS ON ORDERDETAILS.ITEMID = ITEMS.ID
    JOIN ORDERS ON ORDERDETAILS.ORDERID = ORDERS.ID
    JOIN ADDRESS ON ORDERS.ADDRESSID = ADDRESS.ID
    JOIN CITIES ON ADDRESS.CITYID = CITIES.ID
    GROUP BY CITIES.CITY, ITEMS.CATEGORY1, ITEMS.CATEGORY2
)
SELECT CITY, CATEGORY1, CATEGORY2, TOTALSALE
FROM SIRALAMA
WHERE KAT_SIRA <= 3 AND ALT_KAT_SIRA <= 3;
