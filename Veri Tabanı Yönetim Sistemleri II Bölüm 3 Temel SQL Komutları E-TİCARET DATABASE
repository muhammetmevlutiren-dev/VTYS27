CREATE DATABASE SATISLAR;
USE SATISLAR;

CREATE TABLE ORDERS (
	ID INT PRIMARY KEY,
	USERID INT NOT NULL,
	DATE_ DATETIME NOT NULL,
	TOTALPRICE FLOAT NOT NULL,
	STATUS_ NVARCHAR(50) NOT NULL,
	ADDRESSID INT NOT NULL
	
);
CREATE TABLE ORDERDETAILS (
	ID INT PRIMARY KEY,
	ORDERID INT NOT NULL,
	ITEMID INT NOT NULL,
	AMOUNT INT NOT NULL,
	UNITPRICE FLOAT NOT NULL,
	LINETOTAL FLOAT NOT NULL,
);

CREATE TABLE ITEMS (
	ID INT PRIMARY KEY,
	ITEMCODE NVARCHAR(50) NOT NULL,
	ITEMNAME NVARCHAR(100) NOT NULL,
	UNITPRICE FLOAT NOT NULL,
	CATEGORY1 NVARCHAR(50) NOT NULL,
	CATEGORY2 NVARCHAR(50) NOT NULL,
	CATEGORY3 NVARCHAR(50) NOT NULL,
	CATEGORY4 NVARCHAR(50) NOT NULL,
	BRAND NVARCHAR(50) NOT NULL,
);
CREATE TABLE INVOICES (
	ID INT PRIMARY KEY,
	ORDERID INT NOT NULL,
	DATE_ DATETIME NOT NULL,
	ADDRESSID INT NOT NULL,
	CARGOFICHENO NVARCHAR(50) NOT NULL,
	TOTALPRICE FLOAT NOT NULL,
);
CREATE TABLE ADDRESS(
	ID INT PRIMARY KEY,
	USERID INT NOT NULL,
	COUNTRYID INT NOT NULL,
	CITYID INT NOT NULL,
	TOWNID INT NOT NULL,
	DISTRICTID INT NOT NULL,
	POSTALCODE NVARCHAR(20) NOT NULL,
	ADDRESSTEXT NVARCHAR(200) NOT NULL
);
CREATE TABLE TOWNS (
	ID INT PRIMARY KEY,
	CITYID INT NOT NULL,
	TOWN NVARCHAR(100) NOT NULL
);

CREATE TABLE INVOICEDETAILS (
	ID INT PRIMARY KEY,
	INVOICEID INT NOT NULL,
	ORDERDETAILSID INT NOT NULL,
	ITEMID INT NOT NULL,
	AMOUNT INT NOT NULL,
	UNITPRICE FLOAT NOT NULL,
	LINETOTAL FLOAT NOT NULL
);
CREATE TABLE USERS (
	ID INT PRIMARY KEY,
	USERNAME_ NVARCHAR(50) NOT NULL,
	PASSWORD_ NVARCHAR(50) NOT NULL,
	NAMESURNAME NVARCHAR(100) NOT NULL,
	EMAIL NVARCHAR(100) NOT NULL,
	GENDER NVARCHAR(10) NOT NULL,
	BIRTHDATE DATETIME NOT NULL,
	CREATEDATE DATETIME NOT NULL,
	TELNR1 NVARCHAR(20) NOT NULL,
	TELNR2 NVARCHAR(20) NOT NULL,
);

CREATE TABLE CITIES (
	ID INT PRIMARY KEY,
	COUNTRYID INT NOT NULL,
	CITY NVARCHAR(100) NOT NULL
);

CREATE TABLE COUNTRIES (
	ID INT PRIMARY KEY,
	COUNTRY NVARCHAR(100) NOT NULL
);
CREATE TABLE DISTRICTS (
	ID INT PRIMARY KEY,
	TOWNID INT NOT NULL,
	DISTRICT NVARCHAR(100) NOT NULL
);
CREATE TABLE PAYMENTS (
	ID INT PRIMARY KEY,
	ORDERID INT NOT NULL,
	PAYMENTTYPE NVARCHAR(50) NOT NULL,
	DATE_ DATETIME NOT NULL,
	ISOK BIT NOT NULL,
	APPROVECODE NVARCHAR(50) NOT NULL,
	PAYMENTTOTAL FLOAT NOT NULL
	);



